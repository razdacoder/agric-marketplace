# Database (Neon). Leave DATABASE_URL unset locally — vite-plugin-neon-new
# will auto-provision and populate a claimable dev database on `pnpm dev`.
# For production (e.g. Vercel), set this to a real, persistent Postgres
# connection string — not the auto-provisioned claimable dev instance,
# which expires after 72 hours.
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
# BETTER_AUTH_URL must be the actual deployed origin in production
# (e.g. https://your-app.vercel.app).
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret, e.g.: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
