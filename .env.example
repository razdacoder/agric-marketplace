# Database (Neon). Leave DATABASE_URL unset locally — vite-plugin-neon-new
# will auto-provision and populate a claimable dev database on `pnpm dev`.
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # generate with: pnpm dlx @better-auth/cli secret

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
